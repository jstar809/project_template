# 이 파일을 복사해 .env 를 만든다:  copy .env.example .env
# .env 는 절대 커밋하지 않는다.

# ── 실행 프로필 ────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ── DB (postgresql | mysql) ───────────────────────────────────
DB_VENDOR=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=template
DB_USERNAME=template
DB_PASSWORD=template
DB_POOL_SIZE=10
# MySQL 컨테이너 root 비밀번호 (로컬 전용)
DB_ROOT_PASSWORD=root
# 호스트에 노출할 DB 포트 (충돌 시 변경)
POSTGRES_PORT=5432
MYSQL_PORT=3306

# ── 인증 (M2에서 사용) ────────────────────────────────────────
# 32바이트 이상. 예) openssl rand -base64 48
JWT_SECRET=local-development-secret-change-me-please-32bytes-min
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P14D
COOKIE_SECURE=false

# 초기 관리자 계정 (M2에서 사용)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
ADMIN_NICKNAME=관리자

# ── 공통 ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
LOGIN_RATE_LIMIT=10

# ── 파일 저장 (M4에서 사용) ───────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
FILE_MAX_SIZE=10MB

# ── 프론트엔드 ────────────────────────────────────────────────
VITE_API_BASE_URL=/api/v1
