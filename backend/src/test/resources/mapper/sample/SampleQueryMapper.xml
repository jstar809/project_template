<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.template.support.SampleQueryMapper">

    <!-- databaseId로 DB별 SQL을 분기한다. VendorDatabaseIdProvider가 현재 DB를 판별한다. -->
    <select id="currentVendor" resultType="string" databaseId="postgresql">
        SELECT CAST('postgresql' AS VARCHAR)
    </select>

    <select id="currentVendor" resultType="string" databaseId="mysql">
        SELECT 'mysql' FROM DUAL
    </select>

    <!-- 두 DB에서 똑같이 동작하는 표준 SQL -->
    <select id="countBoards" resultType="long">
        SELECT COUNT(*) FROM boards
    </select>

    <select id="countShedlock" resultType="long">
        SELECT COUNT(*) FROM shedlock
    </select>
</mapper>
